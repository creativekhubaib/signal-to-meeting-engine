    {
      "parameters": {
        "jsCode": "const raw = ($json.body?.domain || '').toString().trim().toLowerCase();\nconst domain = raw\n  .replace(/^https?:\\/\\//, '')\n  .replace(/^www\\./, '')\n  .split('/')[0];\nconst valid = /^[a-z0-9.-]+\\.[a-z]{2,}$/.test(domain);\nreturn [{ json: { domain, valid } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
