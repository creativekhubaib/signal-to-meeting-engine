        48
      ],
      "id": "424382ac-8d2c-43c4-bbbe-426557ed6032",
      "name": "Validate input"
    },
    {
      "parameters": {
        "jsCode": "let html = $json.data || '';\nhtml = html\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\nconst text = html.slice(0, 3000);\nconst domain = $('Validate input').first().json.domain;\nreturn [{ json: { domain, text, usable: text.length >= 200 } }];"
      },
      "type": "n8n-nodes-base.code",
