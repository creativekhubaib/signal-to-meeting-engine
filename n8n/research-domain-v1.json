      ],
      "id": "09fe298b-3500-4eb7-be98-8dd8564f9c26",
      "name": "Score ICP",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"fit_score\": 72,\n  \"reason\": \"Small agency selling B2B lead generation, no outbound process stated\",\n  \"evidence\": \"we generate qualified B2B leads\",\n  \"confidence\": \"medium\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1480,
        8
      ],
      "id": "e8f2d8c8-db33-4da1-a148-cebe94a4d982",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const out = $json.output || $json;\nconst domain = $('Extract text').first().json.domain;\nconst score = Number(out.fit_score);\nconst good = Number.isInteger(score) && score >= 0 && score <= 100\n  && ['low', 'medium', 'high'].includes(out.confidence);\nreturn [{ json: good\n  ? { domain, fit_score: score, reason: out.reason, evidence: out.evidence,\n      confidence: out.confidence, status: 'ok' }\n  : { domain, fit_score: null, reason: 'model output failed validation',\n      evidence: 'none', confidence: 'low', status: 'failed' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        -272
      ],
      "id": "6c75dfe1-178e-4974-96e8-aa0873cfc27f",
      "name": "Check output"
    },
    {
      "parameters": {
        "jsCode": "let domain = '';\ntry {\n  domain = $('Validate input').first().json.domain || '';\n} catch (e) {\n  domain = ($json.domain || '').toString();\n}\n\nlet status = 'fallback';\nlet reason = 'homepage unavailable';\n\nif ($json.valid === false) {\n  status = 'fallback';\n  reason = 'invalid domain';\n} else if ($json.usable === false) {\n  status = 'fallback';\n  reason = 'page had too little text';\n} else {\n  let extractRan = false;\n  try {\n    extractRan = Boolean($('Extract text').first()?.json?.usable === true);\n  } catch (e) {\n    extractRan = false;\n  }\n  if (extractRan) {\n    status = 'failed';\n    reason = 'model call failed';\n  } else {\n    status = 'fallback';\n    reason = 'homepage unavailable';\n  }\n}\n\nreturn [{\n  json: {\n    domain,\n    fit_score: null,\n    reason,\n    evidence: 'none',\n    confidence: 'low',\n    status\n  }\n}];"
      },
